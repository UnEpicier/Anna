{
	"name": "@repo/app-types",
	"version": "0.5.0",
	"type": "module",
	"private": true,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"lint": "biome lint src",
		"lint:fix": "biome check src --write",
		"lint:strict": "biome lint src --max-diagnostics=0",
		"format": "biome format src --write",
		"check-types": "tsc --noEmit"
	},
	"peerDependencies": {
		"zod": "^4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^25.5.2"
	}
}
