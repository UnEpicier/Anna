{
	"name": "backend",
	"version": "1.4.1",
	"description": "",
	"author": "Un Épicier",
	"license": "ISC",
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.build.json && tsup",
		"dev": "pnpm run prisma:generate && node --import=tsx --watch src/index.ts",
		"start": "node dist/index.js",
		"clean": "rm -rfd node_modules dist .biome_cache .vitest",
		"lint": "biome lint src",
		"lint:fix": "biome check src --write",
		"lint:strict": "biome lint src --max-diagnostics=0",
		"format": "biome format src --write",
		"pretest": "prisma migrate reset --force && pnpm run prisma:seed",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"prisma:generate": "prisma generate",
		"prisma:seed": "prisma db seed",
		"prisma:migrate": "prisma migrate dev",
		"prisma:deploy": "prisma migrate deploy"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.7.0",
		"@prisma/client": "^7.7.0",
		"@repo/app-types": "workspace:*",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.1",
		"dotenv-expand": "^12.0.3",
		"express": "^5.2.1",
		"express-rate-limit": "^8.3.2",
		"helmet": "^8.1.0",
		"http-status-codes": "^2.3.0",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.10.1",
		"node-cron": "^4.2.1",
		"node-mailjet": "^6.0.11",
		"redis": "^5.11.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^25.5.2",
		"@types/node-cron": "^3.0.11",
		"@types/supertest": "^7.2.0",
		"@vitest/coverage-v8": "^4.1.3",
		"prisma": "^7.7.0",
		"supertest": "^7.2.2",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.3"
	},
	"tsup": {
		"entry": [
			"src/index.ts"
		],
		"outDir": "dist",
		"format": [
			"esm"
		],
		"target": "es2022",
		"sourcemap": true,
		"clean": true,
		"dts": false,
		"splitting": false,
		"skipNodeModulesBundle": true
	}
}
