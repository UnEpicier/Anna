generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Informations {
  id            Int      @id @default(autoincrement())
  email         String
  phone         String
  address       String?
  actionAddress String @default("Bordeaux")
  actionLong    Float @default(-0.56667)
  actionLat     Float @default(44.833328)
  actionRadius  Int @default(30)
  facebook      String?
  instagram     String?
  notifyLeave   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Departments {
  code		   String @id
  name         String
  geojson      Json @db.JsonB
  active       Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Schedules {
  day       String @id
  time      String
  location  String
  open      Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Leave {
  id        Int      @id @default(autoincrement())
  from      DateTime
  to        DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Services {
  id               Int      @id @default(autoincrement())
  title            String
  emoji            String   @default("🐾")
  shortDescription String   @default("")
  price            Decimal  @db.Decimal(10,2)
  duration         String
  description      String
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PopupMessage {
  id        Int      @id @default(autoincrement())
  enabled   Boolean  @default(false)
  title     String?
  message   String
  ctaLabel  String?
  ctaUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}