{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"rootDir": "./src",
		"paths": {
			"@/*": ["./src/*"]
		},
		"moduleResolution": "bundler",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["vitest/globals"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "src/**/__tests__/**", "src/**/*.test.ts"]
}
