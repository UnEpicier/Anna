# Environment Configuration
NODE_ENV="development" # Set the environment to development
PORT="8080"            # The port your server will listen on

# CORS Settings
CORS_ORIGIN="http://localhost:8080" # Allowed CORS origin, adjust as necessary

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS="900000" # Rate limit window in milliseconds (default: 900000 = 15 min)
COMMON_RATE_LIMIT_MAX_REQUESTS="20"  # Max number of requests per window per IP

# PostgreSQL Database Configuration
POSTGRES_HOST="localhost"    # Database host
POSTGRES_PORT="5432"         # Database port
POSTGRES_USER="postgres" 	 # Database user
POSTGRES_PASSWORD="postgres" # Database password
POSTGRES_DB="db" 	   	     # Database name

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public" # Full database connection URL

# Redis Configuration
REDIS_HOST="localhost"       # Redis host
REDIS_PORT="6379"            # Redis port
