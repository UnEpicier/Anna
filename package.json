{
	"name": "anna",
	"private": true,
	"scripts": {
		"deps:up": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env up -d",
		"deps:down": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down",
		"deps:clean": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down -v",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"format": "turbo run format",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@repo/typescript-config": "workspace:*",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"knip": "^6.4.1",
		"semantic-release": "^25.0.3",
		"semantic-release-monorepo": "^8.0.2",
		"turbo": "^2.9.6",
		"typescript": "^6.0.2"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=18"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3",
			"flatted": "^3.4.0",
			"brace-expansion": "^1.1.13",
			"path-to-regexp": "^8.4.0",
			"picomatch": "^4.0.4",
			"vite@>=7.0.0 <=7.3.1": ">=7.3.2",
			"defu@<=6.1.4": ">=6.1.5",
			"vite@>=7.1.0 <=7.3.1": ">=7.3.2"
		}
	}
}
