{
	"name": "anna",
	"private": true,
	"scripts": {
		"deps:up": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env up -d",
		"deps:down": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down",
		"deps:clean": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down -v",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"format": "turbo run format",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"turbo": "^2.8.14",
		"typescript": "5.9.3",
		"@repo/typescript-config": "workspace:*"
	},
	"packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
	"engines": {
		"node": ">=18"
	}
}
