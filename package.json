{
	"name": "anna",
	"private": true,
	"scripts": {
		"deps:up": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env up -d",
		"deps:down": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down",
		"deps:clean": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down -v",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"format": "turbo run format",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.7",
		"@repo/typescript-config": "workspace:*",
		"turbo": "^2.8.19",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
	"engines": {
		"node": ">=18"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3"
		}
	}
}
