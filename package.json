{
	"name": "anna",
	"private": true,
	"scripts": {
		"deps:up": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env up -d",
		"deps:down": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down",
		"deps:clean": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down -v",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"format": "turbo run format",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@repo/typescript-config": "workspace:*",
		"turbo": "^2.8.21",
		"typescript": "^6.0.2"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=18"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3"
		}
	}
}
