{
  "name": "anna",
  "private": true,
  "scripts": {
    "deps:up": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env up -d",
    "deps:down": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down",
    "deps:clean": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down -v",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.8.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8",
  "engines": {
    "node": ">=18"
  }
}
