{
  "name": "anna",
  "private": true,
  "scripts": {
    "deps:up": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env up -d",
    "deps:down": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down",
    "deps:clean": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down -v",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.8.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
  "engines": {
    "node": ">=18"
  }
}
