{
	"name": "anna",
	"private": true,
	"scripts": {
		"deps:up": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env up -d",
		"deps:down": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down",
		"deps:clean": "docker compose -f docker-compose.deps.yaml --env-file ./apps/backend/.env down -v",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"format": "turbo run format",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@repo/typescript-config": "workspace:*",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/npm": "^13.2.0",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"knip": "^6.40.0",
		"semantic-release": "^25.0.9",
		"semantic-release-monorepo": "^8.0.2",
		"turbo": "^2.11.7",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=24"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "19.3.0",
			"@types/react-dom": "19.3.0",
			"flatted": "^3.4.0",
			"brace-expansion": "^1.1.13",
			"path-to-regexp": "^8.4.0",
			"picomatch": "^4.0.4",
			"vite": "7.3.6",
			"defu@<=6.1.4": ">=6.1.5",
			"esbuild": "^0.28.1",
			"mysql2": "^3.23.1",
			"deepmerge-ts": "^8.0.0",
			"maplibre-gl": "^6.4.1"
		}
	}
}
